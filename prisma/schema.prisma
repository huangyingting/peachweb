generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  avatarColor   String     @default("#ff6b4a")
  passwordHash  String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  invitedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  invitedBy           User?              @relation("UserInvitationTree", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers        User[]             @relation("UserInvitationTree")
  sentInvitations     Invitation[]       @relation("InvitedByUser")
  acceptedInvitation  Invitation?        @relation("AcceptedByUser")
  accounts            Account[]
  sessions            Session[]
  ownedWorkspaces     Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  ownedWebsites       Website[]          @relation("WebsiteOwner")
  createdVersions     WebsiteVersion[]
  websiteComments     WebsiteComment[]
  auditLogs           AuditLog[]         @relation("AuditActor")

  @@index([role])
  @@index([status])
}

model Invitation {
  id               String           @id @default(cuid())
  email            String
  tokenHash        String           @unique
  activeForEmail   String?          @unique
  role             UserRole         @default(USER)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedById      String
  acceptedByUserId String?          @unique
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invitedBy      User  @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedByUser User? @relation("AcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorEmail   String?
  action       String
  targetType   String
  targetId     String?
  metadataJson String   @default("{}")
  ipAddress    String?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  plan      String   @default("PRO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  invites  WorkspaceInvite[]
  websites Website[]
  assets   WebsiteAsset[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(EDITOR)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(EDITOR)
  status      String        @default("PENDING")
  invitedById String
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Website {
  id                      String    @id @default(cuid())
  name                    String
  slug                    String    @unique
  description             String?
  category                String    @default("SAAS")
  thumbnailGradient       String    @default("linear-gradient(135deg, #ff6b4a 0%, #9333ea 50%, #0f172a 100%)")
  workspaceId             String
  ownerId                 String
  templateId              String?
  isArchived              Boolean   @default(false)
  isCustomTemplate        Boolean   @default(false)
  isPublished             Boolean   @default(false)
  publishedAt             DateTime?
  uiStateJson             String
  sceneStateJson          String
  publishedUiStateJson    String?
  publishedSceneStateJson String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User             @relation("WebsiteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions  WebsiteVersion[]
  comments  WebsiteComment[]
  assets    WebsiteAsset[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([isArchived])
  @@index([isPublished])
}

model WebsiteVersion {
  id             String   @id @default(cuid())
  websiteId      String
  label          String
  uiStateJson    String
  sceneStateJson String
  createdById    String
  createdAt      DateTime @default(now())

  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([createdAt])
}

model WebsiteComment {
  id        String   @id @default(cuid())
  websiteId String
  authorId  String
  pageId    String   @default("home")
  content   String
  xPercent  Float    @default(50)
  yPercent  Float    @default(35)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model WebsiteAsset {
  id          String   @id @default(cuid())
  websiteId   String?
  workspaceId String
  name        String
  type        String   @default("model-3d")
  url         String
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  website   Website?  @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([websiteId])
}
